# Base URL of the deployed Expo Router API server, without /api/recognize
EXPO_PUBLIC_API_URL=http://localhost:8081
# Server-only: never prefix secrets with EXPO_PUBLIC_
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini
# On a physical device use a reachable API server address, not localhost.
# Expo Go / static web export does not automatically host API routes; deploy a server-capable Expo Router backend.
