{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notex",
  "version": "1.0.0",
  "identifier": "com.notex.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1431",
    "beforeDevCommand": "npm run tauri:export && npm run tauri:serve",
    "beforeBuildCommand": "npm run tauri:export"
  },
  "app": {
    "windows": [
      {
        "title": "Notex",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**",
          "$APPDATA/images/**",
          "$APPDATA/page-assets/**",
          "$APPDATA/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
